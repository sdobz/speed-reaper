#!/usr/bin/env bash
# tools/check — one command that every ralph Verify starts from.
# Builds speedcli + the REAPER plugin warning-free, runs plugin unit tests,
# checks the plugin still exports ReaperPluginEntry, and cross-builds the
# Windows plugin DLL (nix build .#reaper-plugin-windows; SKIP_WINDOWS=1 skips).
# Usage: tools/check [ctest-regex]     (regex filters unit tests by name)
# After ctest, runs the oracle host layer; ORACLE_FULL=1 runs all layers.
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v cmake >/dev/null; then exec nix develop --command "$0" "$@"; fi

make -C src >/dev/null
cmake -S plugin -B build/plugin -G Ninja -DCMAKE_CXX_FLAGS=-Werror -DSPEED_REAPER_FAKE_DEVICE=ON >/dev/null
cmake --build build/plugin
nm -D build/plugin/reaper_speed_reaper.so | grep -q ' T ReaperPluginEntry'
ctest --test-dir build/plugin --output-on-failure ${1:+-R "$1"}
# Windows cross build (MinGW): catches POSIX-only code / missing sources.
if [[ "${SKIP_WINDOWS:-0}" != 1 ]]; then
  tools/windows-oracle --layer static
fi
# Oracle (docs/plugin-oracle-design.md §1): host layer by default;
# ORACLE_FULL=1 runs all layers, all scenarios.
if [[ "${ORACLE_FULL:-0}" == 1 ]]; then
  tools/reaper-oracle
else
  tools/reaper-oracle --layer host
fi
