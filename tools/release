#!/usr/bin/env bash
# tools/release — build the release zips (42-release-prep §6).
#
# Produces dist/speed-reaper-<version>-<platform>.zip, one per platform in
# CROSS-PLATFORM.md (Linux .so, Windows .dll cross-build). Each zip contains
# the binary, README.md, LICENSE, docs/bindings.md, and — Linux only — the
# udev rule (share/99-blackmagic-speed-editor.rules). macOS is unsupported
# (README says "build from source"); the cross platform matrix is
# Linux + Windows only (CROSS-PLATFORM.md).
#
# Version comes from one place: plugin/CMakeLists.txt project(VERSION …).
# The Linux .so is a production build (SPEED_REAPER_FAKE_DEVICE OFF —
# tools/check's build/plugin is a test build and is NOT reused).
# SKIP_WINDOWS=1 skips the (slow) nix Windows cross-build.
set -euo pipefail
cd "$(dirname "$0")/.."

VERSION=$(awk '/^project\(.*VERSION /{print $3; exit}' plugin/CMakeLists.txt)
[[ -n "${VERSION:-}" ]] || { echo "no VERSION in plugin/CMakeLists.txt" >&2; exit 1; }

# flake.nix' pluginVersion must match (nix attr for derivation names only;
# the CMakeLists version is the single source of truth — see flake.nix note).
if command -v nix >/dev/null; then
  FLAKE_V=$(nix eval --raw .#packages.x86_64-pc-windows-gnu.reaper-plugin.version 2>/dev/null || true)
  if [[ -n "${FLAKE_V:-}" && "$FLAKE_V" != "$VERSION" ]]; then
    echo "flake.nix pluginVersion ($FLAKE_V) != plugin/CMakeLists.txt ($VERSION) — keep them in sync" >&2
    exit 1
  fi
fi

echo "releasing speed-reaper $VERSION"

# Windows .dll — needs nix only (works before or inside the dev shell).
WIN_DLL=""
if [[ "${SKIP_WINDOWS:-0}" != 1 ]] && command -v nix >/dev/null; then
  WIN_OUT=$(nix build .#reaper-plugin-windows --print-out-paths)
  WIN_DLL="$WIN_OUT/reaper/reaper_speed_reaper.dll"
fi

# Linux .so — needs the nix dev env (cmake + gdk-3.0 for SWELL).
if ! command -v cmake >/dev/null; then
  exec nix develop --command "$0" "$@"
fi
cmake -S plugin -B build/release-linux -G Ninja -DCMAKE_CXX_FLAGS=-Werror >/dev/null
cmake --build build/release-linux >/dev/null

mkdir -p dist
rm -f "dist/speed-reaper-${VERSION}-linux-x86_64.zip" \
      "dist/speed-reaper-${VERSION}-windows-x86_64.zip"

zip_it() { # zip_it <target> <artifact:arcname> [src:arcname ...]
  local target=$1; shift
  python3 - "$target" "$@" <<'PY'
import os, sys, zipfile
target, entries = sys.argv[1], sys.argv[2:]
# Fixed timestamp: nix store files are dated epoch 0 (zipfile rejects
# pre-1980), and a constant stamp keeps the release zips reproducible.
DT = (1980, 1, 1, 0, 0, 0)
with zipfile.ZipFile(target, "w", zipfile.ZIP_DEFLATED) as z:
    for e in entries:
        src, _, arc = e.partition(":")
        zi = zipfile.ZipInfo(arc or src, date_time=DT)
        zi.external_attr = (os.stat(src).st_mode & 0xFFFF) << 16
        with open(src, "rb") as f:
            z.writestr(zi, f.read())
print(target)
PY
}

zip_it "dist/speed-reaper-${VERSION}-linux-x86_64.zip" \
  "build/release-linux/reaper_speed_reaper.so:reaper_speed_reaper.so" \
  "README.md" "LICENSE" "docs/bindings.md" \
  "share/99-blackmagic-speed-editor.rules:99-blackmagic-speed-editor.rules"

if [[ -n "$WIN_DLL" ]]; then
  zip_it "dist/speed-reaper-${VERSION}-windows-x86_64.zip" \
    "$WIN_DLL:reaper_speed_reaper.dll" \
    "README.md" "LICENSE" "docs/bindings.md"
else
  echo "warning: Windows zip skipped (SKIP_WINDOWS=1 or no nix)" >&2
fi

ls -l dist/speed-reaper-*.zip
