#!/usr/bin/env bash
# tools/reaper-oracle — agent-runnable verdict on "does the plugin load and work".
# Design: docs/plugin-oracle-design.md §1 (command), §3 (host layer), §4 (REAPER layer).
#
# Usage:
#   tools/reaper-oracle [--layer host|reaper|all] [--scenario NAME]
#                       [--platform linux|windows] [--report-only]
#
# Without --scenario, the reaper layer runs the full scenario suite
# (load, jog_demo, hid_wheel, buttons, verbs, ripple_del, shuttle, target);
# --scenario NAME runs only that scenario.
# A scenario may ship an oracle/scenarios/<NAME>.env file that is sourced
# before reaper starts (e.g. hid_wheel.env sets SPEED_REAPER_FAKE_DEVICE).
#
# Prints one final line: ORACLE PASS <layer>[/<scenario(,scenario)>] or
# ORACLE FAIL <layer>[/<scenario(,scenario)>]: <reason>; exit 0 on PASS.
# --report-only: exit 0 whenever the harness itself worked (artifacts written).
#
# Artifacts (always, in build/oracle/): result.json, trace.txt,
# reaper.stderr, probe.json (reaper layer);
# on hang (no probe.json within the timeout): hang_bt.txt (gdb attach to the
# live process); on crash (reaper exit >=128): bt.txt (gdb backtrace) and
# reaper.stderr is replaced by the LD_DEBUG=libs loader log (filtered to
# lines mentioning speed_reaper).
set -euo pipefail
cd "$(dirname "$0")/.."

LAYER=all
SCENARIO=load
SCENARIO_EXPLICIT=0
PLATFORM=linux
REPORT_ONLY=0
ORIG_ARGS=("$@")
while [[ $# -gt 0 ]]; do
  case "$1" in
    --layer)       [[ $# -ge 2 ]] || { echo "missing value for --layer" >&2; exit 2; }
                   LAYER="$2"; shift 2 ;;
    --scenario)    [[ $# -ge 2 ]] || { echo "missing value for --scenario" >&2; exit 2; }
                   SCENARIO="$2"; SCENARIO_EXPLICIT=1; shift 2 ;;
    --platform)    [[ $# -ge 2 ]] || { echo "missing value for --platform" >&2; exit 2; }
                   PLATFORM="$2"; shift 2 ;;
    --report-only) REPORT_ONLY=1; shift ;;
    *) echo "tools/reaper-oracle: unknown option: $1" >&2; exit 2 ;;
  esac
done
case "$LAYER" in host|reaper|all) ;; *)
  echo "tools/reaper-oracle: --layer must be host|reaper|all (got $LAYER)" >&2; exit 2 ;;
esac
case "$PLATFORM" in linux|windows) ;; *)
  echo "tools/reaper-oracle: --platform must be linux|windows (got $PLATFORM)" >&2; exit 2 ;;
esac
if [[ "$PLATFORM" == windows ]]; then
  echo "tools/reaper-oracle: --platform windows is not implemented yet (see vibes/19-oracle-device-windows.md)" >&2
  exit 2
fi
# Re-exec in the dev shell (has cmake + reaper + xvfb-run), like tools/check.
if ! command -v reaper >/dev/null 2>&1; then
  exec nix develop --command "$0" "${ORIG_ARGS[@]}"
fi

OUT=build/oracle
mkdir -p "$OUT"
SCENARIO_TIMEOUT=${ORACLE_SCENARIO_TIMEOUT:-20}

# One Xvfb for the whole run. (xvfb-run costs a fixed ~3 s per invocation.)
XVFB_PID=""
start_xvfb() {
  [[ -n "$XVFB_PID" ]] && return 0
  local d i
  for i in 1 2 3 4 5 6 7 8; do
    d=$((100 + RANDOM % 800))
    grep -q "X$d\$" /proc/net/unix 2>/dev/null && continue
    Xvfb ":$d" -screen 0 1280x1024x24 -nolisten tcp >/dev/null 2>&1 &
    XVFB_PID=$!
    # wait (up to 5 s) for the socket instead of a fixed sleep
    local w
    for w in $(seq 50); do
      # socket is a file or (sandboxed /tmp) an abstract unix socket
      if [[ -e "/tmp/.X11-unix/X$d" ]] || grep -q "X$d\$" /proc/net/unix; then
        export DISPLAY=":$d"; return 0
      fi
      kill -0 "$XVFB_PID" 2>/dev/null || break
      sleep 0.1
    done
    kill "$XVFB_PID" 2>/dev/null || true; XVFB_PID=""
  done
  echo "tools/reaper-oracle: Xvfb did not start" >&2; exit 2
}
trap 'stop_dismisser 2>/dev/null; [[ -n "$XVFB_PID" ]] && kill "$XVFB_PID" 2>/dev/null || true' EXIT

# --- host layer -------------------------------------------------------------
run_host() {
  # tools/check's cmake flags.
  cmake -S plugin -B build/plugin -G Ninja -DCMAKE_CXX_FLAGS=-Werror -DSPEED_REAPER_FAKE_DEVICE=ON >/dev/null
  cmake --build build/plugin
  rm -f "$OUT/plugin_host.out" "$OUT/trace.txt"
  SPEED_REAPER_TRACE="$PWD/$OUT/trace.txt" \
    ./build/plugin/plugin_host build/plugin/reaper_speed_reaper.so \
      --expect-entry 1 \
      --expect-actions speed_reaper_jogdemo,speed_reaper_scrub_fwd,speed_reaper_scrub_back \
      > "$OUT/plugin_host.out" 2>&1
  HOST_RC=$?
  # Store plugin_host's output in trace.txt alongside the plugin trace.
  cat "$OUT/plugin_host.out" >> "$OUT/trace.txt"
}

# REAPER opens modal dialogs at startup in a fresh profile ("Error opening
# devices", the evaluation "About REAPER" nag, "New Version Notification").
# While one is open REAPER does not run plugin timers, so the jog engine
# freezes mid-scenario and Quit hangs. Dismiss them with Return (NOT by
# closing the X window — that leaves REAPER's modal loop stuck).
DISMISSER_PID=""
start_dismisser() {
  command -v xdotool >/dev/null 2>&1 || return 0
  (
    while true; do
      for w in $(xdotool search --onlyvisible --name "About REAPER|Notification|Error opening" 2>/dev/null); do
        xdotool key --window "$w" Return 2>/dev/null || true
      done
      sleep 0.1
    done
  ) &
  DISMISSER_PID=$!
}
stop_dismisser() {
  [[ -n "$DISMISSER_PID" ]] && kill "$DISMISSER_PID" 2>/dev/null || true
  DISMISSER_PID=""
}

# --- reaper layer -----------------------------------------------------------
run_reaper() {
  local env_file="oracle/scenarios/$SCENARIO.env"
  # Keep per-scenario env isolated between scenarios in the suite.
  unset SPEED_REAPER_FAKE_DEVICE
  if [[ -f "$env_file" ]]; then
    # shellcheck disable=SC1090
    . "$env_file"
  fi
  # Isolated HOME, wiped each run.
  start_xvfb
  rm -rf "$OUT/home"
  mkdir -p "$OUT/home/.config/REAPER/UserPlugins"
  cp build/plugin/reaper_speed_reaper.so "$OUT/home/.config/REAPER/UserPlugins/"
  # Licensed copy (kept outside the repo) avoids the nag screen / browser launch.
  [[ -f "${REAPER_LICENSE:-$HOME/.config/REAPER/reaper-license.rk}" ]] \
    && cp "${REAPER_LICENSE:-$HOME/.config/REAPER/reaper-license.rk}" "$OUT/home/.config/REAPER/reaper-license.rk"
  # Pre-seed a profile so REAPER starts with no modal dialogs and no browser:
  #   verchk=0            no update check -> no "New Version Notification"/download page
  #   linux_audio_mode=3  audio mode that opens without hardware -> no "Error opening devices"
  # (found empirically with REAPER 7.81 under Xvfb; mode 0,1,2,4,6 all fail to open)
  printf '[REAPER]\nverchk=0\nlinux_audio_mode=3\n' > "$OUT/home/.config/REAPER/reaper.ini"
  # Never let REAPER (or anything it spawns) reach the host's browser/D-Bus session.
  mkdir -p "$OUT/home/bin"
  printf '#!/bin/sh\necho "$0 $*" >> "%s/blocked_open.log"\n' "$PWD/$OUT" > "$OUT/home/bin/xdg-open"
  chmod +x "$OUT/home/bin/xdg-open"
  rm -f "$OUT/probe.json" "$OUT/reaper.stderr" "$OUT/trace_$SCENARIO.txt"
  # (the per-scenario trace is wiped for every layer: Trace appends, so a
  # stale file from a previous run would double the checkable lines)
  REAPER_RC=0
  if [[ "$LAYER" == reaper ]]; then rm -f "$OUT/trace.txt"; fi
  rm -f "$OUT/probe.json.tmp" "$OUT/hang_bt.txt"
  start_dismisser
  # probe.json (written atomically by finish()) is the finish line: as soon as
  # it exists REAPER is killed — no waiting on Quit, which a dirty project's
  # "save changes?" Query can block forever. rc stays 0 in that case.
  HOME="$OUT/home" PATH="$PWD/$OUT/home/bin:$PATH" BROWSER="$PWD/$OUT/home/bin/xdg-open" DBUS_SESSION_BUS_ADDRESS= \
  ORACLE_LIB="$PWD/oracle/lib.lua" \
  ORACLE_SCENARIO="$PWD/oracle/scenarios/$SCENARIO.lua" \
  ORACLE_OUT="$PWD/$OUT" \
  SPEED_REAPER_TRACE="$PWD/$OUT/trace_$SCENARIO.txt" \
    reaper -newinst -nosplash oracle/run.lua 2> "$OUT/reaper.stderr" &
  local pid=$! deadline=$((SECONDS + SCENARIO_TIMEOUT))
  while kill -0 "$pid" 2>/dev/null; do
    if [[ -f "$OUT/probe.json" ]]; then
      kill -KILL "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true
      stop_dismisser; return 0
    fi
    if (( SECONDS >= deadline )); then
      # Hung: grab a backtrace of the live process (seconds, not a re-run).
      local elf; elf=$(pgrep -P "$pid" -f reaper-wrapped || true)
      gdb -batch -p "${elf:-$pid}" -ex 'thread apply all bt' > "$OUT/hang_bt.txt" 2>&1 || true
      kill -KILL "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true
      REAPER_RC=124; stop_dismisser; return 0
    fi
    sleep 0.05
  done
  wait "$pid" || REAPER_RC=$?
  # exited on its own (e.g. Quit after finish, or a crash)
  stop_dismisser
}

# --- crash capture (vibes/18-oracle-linux.md task 6) ------------------------
# On crash (exit >= 128) or timeout (exit 124): re-run the same command
# under gdb for a backtrace (bt.txt) and under LD_DEBUG=libs, filtered to
# lines mentioning our plugin, into reaper.stderr.
run_crash_capture() {
  local reaper_args=(-newinst -nosplash oracle/run.lua)
  export ORACLE_SCENARIO="$PWD/oracle/scenarios/$SCENARIO.lua"
  local env_file="oracle/scenarios/$SCENARIO.env"
  if [[ -f "$env_file" ]]; then
    # shellcheck disable=SC1090
    . "$env_file"
  fi
  # `reaper` on PATH is a nix wrapper script; gdb cannot exec scripts, so
  # gdb the real ELF and use the wrapper as exec-wrapper (it sets
  # LD_LIBRARY_PATH & co, then exec's the ELF, which becomes gdb's child).
  local launcher elf
  launcher=$(readlink -f "$(command -v reaper)")
  elf="$(dirname "$launcher")/.reaper-wrapped"
  if [[ ! -x "$elf" ]]; then
    echo "tools/reaper-oracle: crash capture: cannot resolve reaper ELF from $launcher" >&2
    return 0
  fi
  rm -f "$OUT/bt.txt"
  HOME="$OUT/home" ORACLE_LIB="$PWD/oracle/lib.lua" ORACLE_OUT="$PWD/$OUT" \
  SPEED_REAPER_TRACE="$PWD/$OUT/trace_$SCENARIO.txt" \
    timeout "$SCENARIO_TIMEOUT" gdb -batch -ex "set exec-wrapper $launcher" \
      -ex run -ex bt --args "$elf" "${reaper_args[@]}" \
      > "$OUT/bt.txt" 2>&1 || true
  ( HOME="$OUT/home" ORACLE_LIB="$PWD/oracle/lib.lua" ORACLE_OUT="$PWD/$OUT" \
    SPEED_REAPER_TRACE="$PWD/$OUT/trace_$SCENARIO.txt" \
      LD_DEBUG=libs timeout "$SCENARIO_TIMEOUT" reaper "${reaper_args[@]}" \
      2>&1 ) | grep -i speed_reaper > "$OUT/reaper.stderr" || true
}

# Reaper-layer scenario suite: explicit --scenario wins; otherwise the bare
# run (layer all) runs load, then jog_demo (vibes/18-oracle-linux.md task 9),
# then hid_wheel (vibes/20-m1-wheel-playhead.md task 7), then buttons
# (vibes/21-m2-buttons-modes.md task 4), then verbs (vibes/22-m3-edit-verbs.md
# task 5), then ripple_del (M3: cmd 40006 delete + gap behavior under each
# ripple mode; SMOKE-TEST.md "M3" step 4), then shuttle (M4: SHTL law
# end-to-end — vibes/23-m4-shuttle.md task 6), then target (M5: composite
# ids + targeting behavior — vibes/31-m5-targeting.md task 6), then
# simple_verbs (M6: CAM/AUDIO LEVEL/PLACE ON TOP/SMTH CUT/view verbs/FULL
# VIEW — vibes/32-m6-simple-verbs.md task 6), then hold_move_trim
# (M7: SPLIT move + TRIM OUT holds — vibes/33-m7-hold-rotate.md task 5a).
REAPER_SCENARIOS=("$SCENARIO")
if [[ $SCENARIO_EXPLICIT -eq 0 && "$LAYER" == all ]]; then
  REAPER_SCENARIOS=(load jog_demo hid_wheel buttons verbs ripple_del shuttle target simple_verbs smth_cut place_on_top view_solo hold_move_trim hold_slip_vol hold_undo)
fi

HOST_RC=0
REAPER_RC=0
if [[ "$LAYER" == host || "$LAYER" == all ]]; then
  run_host || true
fi
SCENARIO_RCS=()
if [[ "$LAYER" == reaper || "$LAYER" == all ]]; then
  for s in "${REAPER_SCENARIOS[@]}"; do
    SCENARIO="$s"
    rm -f "$OUT/probe_$s.json"
    run_reaper || true
    if [[ -f "$OUT/probe.json" ]]; then mv "$OUT/probe.json" "$OUT/probe_$s.json"; fi
    # Re-run under gdb/LD_DEBUG only for a real crash; a hang already got
    # hang_bt.txt from the live process (re-running costs 2x the timeout).
    if [[ $REAPER_RC -ge 128 ]]; then
      run_crash_capture || true
    fi
    SCENARIO_RCS+=("$s|$OUT/probe_$s.json|$REAPER_RC")
  done
fi
# trace.txt: per-scenario plugin traces, concatenated in run order.
if [[ ${#SCENARIO_RCS[@]} -gt 0 ]]; then
  { for s in "${REAPER_SCENARIOS[@]}"; do [[ -f "$OUT/trace_$s.txt" ]] && cat "$OUT/trace_$s.txt"; done; } \
    > "$OUT/trace.txt" 2>/dev/null || true
fi

# --- result.json (derived from probe.json / plugin_host.out + exit codes) ---
python3 - "$OUT" "$LAYER" "$HOST_RC" ${SCENARIO_RCS[@]+"${SCENARIO_RCS[@]}"} <<'PYEOF'
import json, os, sys

out, layer, host_rc = sys.argv[1], sys.argv[2], int(sys.argv[3])
# entries: (scenario, probe_path, reaper_rc) per reaper-layer scenario run
entries = [e.split("|") for e in sys.argv[4:]]
scenario = ",".join(e[0] for e in entries) if entries else ""
checks, info, reasons = [], {}, []

def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""

if layer in ("host", "all"):
    host_out = read(os.path.join(out, "plugin_host.out"))
    entry_line = next((l for l in reversed(host_out.splitlines()) if l.startswith("entry=")), "")
    if not entry_line:
        entry_line = "plugin_host did not complete: " + "\n".join(host_out.splitlines()[-3:])
    host_ok = host_rc == 0
    checks.append({"name": "host", "pass": host_ok,
                   "detail": entry_line + ("" if host_ok else f" [plugin_host exit {host_rc}]")})
    if not host_ok:
        reasons.append(f"host: entry/actions expectations not met (plugin_host exit {host_rc})")

if layer in ("reaper", "all"):
    for name, probe_path, rc_s in entries:
        reaper_rc = int(rc_s)
        probe = {}
        try:
            probe = json.load(open(probe_path))
        except (OSError, ValueError):
            pass
        if not probe.get("checks"):
            if reaper_rc == 124:
                reason = ("scenario timeout (no probe.json within "
                          + os.environ.get("ORACLE_SCENARIO_TIMEOUT", "20") + " s; see hang_bt.txt)")
            elif reaper_rc >= 128:
                reason = f"crash (reaper exit {reaper_rc}, no probe.json)"
            else:
                reason = f"reaper run failed (exit {reaper_rc}, no probe.json)"
            checks.append({"name": f"{name}: reaper", "pass": False, "detail": reason})
            reasons.append(f"{name}: " + reason)
        else:
            info.update(probe.get("info", {}))
            for c in probe["checks"]:
                checks.append({"name": f"{name}: {c.get('name', '')}",
                               "pass": bool(c.get("pass")),
                               "detail": c.get("detail", "")})
            failed = [c["name"] for c in probe["checks"] if not c.get("pass")]
            if failed:
                reasons.append(f"{name}: check(s) failed: " + ", ".join(failed))

if layer == "all":
    # A scenario that never called finish() is a FAIL (reason: scenario timeout)
    # — already covered above via "no probe.json".
    pass
p = not reasons
result = {"layer": layer, "scenario": scenario, "pass": p,
          "reason": "; ".join(reasons), "checks": checks}
if info:
    result["info"] = info
with open(os.path.join(out, "result.json"), "w") as f:
    json.dump(result, f, indent=2)
    f.write("\n")
print(f"PASS={p} REASONS={json.dumps(reasons)}")
PYEOF

# --- final line -------------------------------------------------------------
if [[ "$LAYER" == host ]]; then LABEL=host; else
  SCENARIOS_CSV=$(IFS=,; echo "${REAPER_SCENARIOS[*]}")
  LABEL="$LAYER/$SCENARIOS_CSV"
fi
RESULT_PASS=$(python3 -c "import json,sys; print('1' if json.load(open(sys.argv[1]))['pass'] else '0')" "$OUT/result.json")
REASON=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['reason'])" "$OUT/result.json")
if [[ "$RESULT_PASS" == 1 ]]; then
  echo "ORACLE PASS $LABEL"
  exit 0
fi
echo "ORACLE FAIL $LABEL: $REASON"
if [[ "$REPORT_ONLY" == 1 ]]; then exit 0; fi
exit 1
