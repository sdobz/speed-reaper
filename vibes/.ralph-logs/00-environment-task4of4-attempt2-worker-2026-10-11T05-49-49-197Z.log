        import re
        p = 'docs/reaper-api-subset.md'
        lines = open(p, encoding='utf-8').read().split('\n')
        out = []
        fixed = 0
        i = 0
        while i < len(lines):
            m = re.match(r'^- \*\*([A-Za-z_0-9]+)\*\* — Python: ``$', lines[i])
            if m and i + 1 < len(lines):
                nm = m.group(1)
                c = re.match(r'^  ([A-Za-z0-9]+): (.+)$', lines[i+1])
                assert c, f'no continuation for {nm} at line {i+1}: {lines[i+1]!r}'
                lang, sig = c.groups()
                out.append(f'- **{nm}** — {lang}: `{sig}`')
                i += 2
                fixed += 1
                continue
            out.append(lines[i])
            i += 1
        assert fixed == 17, f'expected 17 fixes, got {fixed}'
        open(p, 'w', encoding='utf-8').write('\n'.join(out))
        print(f'fixed {fixed} entries')
        EOF[0m
