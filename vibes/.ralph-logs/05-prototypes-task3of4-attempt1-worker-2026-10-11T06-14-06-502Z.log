#pragma once
// Ported from docs/speed-editor-examples/cpp-driver/src/hid_device.h
// (John-Howard/PythonSpeedEditor @ 28057b4, BSD-3-Clause).
// Changes vs. the vendored reference:
//  - SDR++ flog dependency dropped (plain stderr logging in the .cpp)
//  - authenticate() optionally returns the device's re-auth timeout (seconds)
//  - setJogMode() made public; battery input report supported
#include <cstdint>
#include <string>
#include <hidapi/hidapi.h>
#include "event_types.h"

class SpeedEditorHID {
public:
    enum class State { Disconnected, Authenticating, Connected };

    SpeedEditorHID();
    ~SpeedEditorHID();

    bool open(const std::string& serialFilter = "");
    void close();

    // Runs the challenge-response auth handshake (SET_FEATURE/GET_FEATURE,
    // report 0x06, 10-byte reports). On success, if non-null, *timeoutSec
    // receives the re-auth timeout reported by the device (observed: 600).
    bool authenticate(int* timeoutSec = nullptr);

    void sendInitReports();
    void setJogMode(int mode);

    bool readEvent(SpeedEditorEvent& event, int timeoutMs = 100);

    void setLeds(uint8_t b0, uint8_t b1, uint8_t b2);
    void setJogLeds(bool jog, bool shtl, bool scrl);
    void allLedsOff();
    void ledChaseDemo();

    State getState() const { return state; }
    std::string getSerial() const { return serial; }

private:
    static uint64_t rol8(uint64_t value);
    static uint64_t rol8n(uint64_t value, int n);
    static uint64_t calculateResponse(uint64_t challenge);

    void sendFeatureReport(const uint8_t* data, size_t len);
    int recvFeatureReport(uint8_t reportId, uint8_t* buf, size_t len);
    void writeOutputReport(const uint8_t* data, size_t len);

    hid_device* dev = nullptr;
    State state = State::Disconnected;
    std::string serial;
};
```

Note: removed `<atomic>` (not used).

**hid_device.cpp** — port with the following changes:
- `#include <utils/flog.h>` → nothing; use a local `se_log(level, fmt, ...)` helper.
- 10-byte feature reports:
  - Request: `{0x06, 0x00, 8x0x00}` (10 bytes)
  - Ack: `{0x06, 0x01, 8x0x00}`
  - Response: `{0x06, 0x03, 8-byte response}`
  - Receive: 10 bytes, check [0]==0x06 && [1]==expected step.
- authenticate checks step values like bmd.py: challenge step 0x00, device response step 0x02, status step 0x04. The vendored C++ only checks the final 0x04 (it ignores the ack response's step). I'll validate each step like bmd.py (stricter, matches the reference).
- On success, parse the timeout u16 LE at result[2..3] and return via pointer.
- sendInitReports → sendJogModeReport(0): 7 bytes `{0x03, mode, 0,0,0,0, 0xFF}`.
- setJogMode(int mode) is public: validates 0..3, sends the report.
- readEvent: add battery (0x07): res >= 3, charging=buf[1], level=buf[2].
- close(): keep allLedsOff() before hid_close.
