#pragma once
// Ported from docs/speed-editor-examples/cpp-driver/src/event_types.h
// (John-Howard/PythonSpeedEditor @ 28057b4, BSD-3-Clause).
#include <cstdint>
#include <vector>
#include <string>

enum class EventType {
    Wheel,
    Button,
    Battery,
    Unknown,
};

enum class WheelMode : uint8_t {
    RELATIVE_0        = 0,   // JOG — frame-by-frame relative stepping
    ABSOLUTE_CONTINUOUS = 1, // SHTL — absolute, baseline at mode entry
    RELATIVE_2        = 2,   // SCRL — relative (believed identical to 0)
    ABSOLUTE_DEADZERO = 3,   // absolute with deadband around zero
};

struct WheelEvent {
    WheelMode mode;
    int32_t delta;
};

struct ButtonEvent {
    std::vector<uint16_t> keycodes;
    bool isRelease() const { return keycodes.empty(); }
};

struct BatteryEvent {
    bool charging;
    int level;  // 0-100
};

struct SpeedEditorEvent {
    EventType type = EventType::Unknown;
    WheelEvent wheel{};
    ButtonEvent button{};
    BatteryEvent battery{};
};
