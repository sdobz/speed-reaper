```cpp
// speed-editor-cli — plain test CLI for the Blackmagic Speed Editor.
//
// Demonstrates the HID control capabilities we need for the REAPER plugin
// (vibes/05-prototypes.md, "Speed Editor hello world"):
//   list        — find the device on the USB bus
//   connect     — full auth handshake + init reports + LED hello blink
//   watch       — live decode of buttons / wheel / battery input
//   leds ...    — drive both LED subsystems (output reports 0x02 / 0x04)
//   wheel-mode  — drive the jog wheel mode (output report 0x03)
//   demo        — connect + LED chase + 20 s of live watch
//
// Protocol reference: docs/speed-editor-capabilities.md.
// Driver ported from docs/speed-editor-examples/cpp-driver/src (BSD-3-Clause).

#include "hid_device.h"
#include "key_map.h"

#include <atomic>
#include <chrono>
#include <csignal>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <thread>
#include <vector>

namespace {

std::atomic<bool> g_stop{false};
void onSignal(int) { g_stop = true; }

int nowMs() {
    using namespace std::chrono;
    return (int)duration_cast<milliseconds>(steady_clock::now().time_since_epoch()).count();
}

bool sleepMs(int ms) {
    // Interruptible sleep so Ctrl-C is responsive.
    for (int slept = 0; slept < ms; slept += 50) {
        if (g_stop) return false;
        std::this_thread::sleep_for(std::chrono::milliseconds(50));
    }
    return true;
}

// Open the device and run the full handshake. Prints progress. Returns false
// on any failure (already logged).
bool openAndAuth(SpeedEditorHID& se, bool withInit, int* authTimeoutSec = nullptr) {
    if (!se.open()) {
        std::fprintf(stderr, "error: no Speed Editor found (VID 0x%04X, PID 0x%04X)\n",
                     SPEED_EDITOR_VID, SPEED_EDITOR_PID);
        std::fprintf(stderr, "        check: USB-C cable, `lsusb | grep 1edb:da0e`, hidraw permissions,\n"
                             "        and that DaVinci Resolve is not holding the device (it claims it exclusively).\n");
        return false;
    }
    std::printf("device   %s (serial: %s)\n",
                se.getSerial().empty() ? "??" : se.getSerial().c_str(), ...);
```

