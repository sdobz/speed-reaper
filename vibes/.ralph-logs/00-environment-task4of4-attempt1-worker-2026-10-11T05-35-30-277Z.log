        import re, html as h, json
        raw = open('docs/reaper-api.htm', encoding='utf-8', errors='replace').read()
        
        def clean(s):
            s = re.sub(r'<br\s*/?>', '\n', s)
            s = re.sub(r'<[^>]+>', '', s)
            s = h.unescape(s)
            s = re.sub(r'[ \t]+', ' ', s)
            s = re.sub(r'\n\s*', '\n', s)
            return s.strip()
        
        def sig(div_html):
            if not div_html: return ''
            m = re.search(r'<code>(.*?)</code>', div_html, re.S)
            if not m: return ''
            return clean(m.group(1))
        
        parts = re.split(r'<a name="([^"]+)"><hr></a>', raw)
        entries = {}
        for i in range(1, len(parts)-1, 2):
            name, body = parts[i], parts[i+1]
            sigs = {}
            last_end = 0
            for lang in ('c','e','l','p'):
                m = re.search(rf'<div class="{lang}_func".*?</div>', body, re.S)
                if m:
                    sigs[lang] = sig(m.group(0))
                    last_end = max(last_end, m.end())
            entries[name] = {'c': sigs.get('c',''), 'e': sigs.get('e',''),
                             'l': sigs.get('l',''), 'p': sigs.get('p',''),
                             'doc': clean(body[last_end:])}
        
        print("total:", len(entries))
        no_doc = [n for n,x in entries.items() if not x['doc']]
        print("empty docs:", no_doc)
        for name in ['GetSetProjectInfo','lua_defer','CSurf_ScrubAmt','GetMediaItemInfo_Value','MB']:
            x = entries[name]
            print(f"--- {name}: c={x['c'][:80]!r} l={x['l'][:60]!r} doc_len={len(x['doc'])}")
            print("   doc start:", x['doc'][:200].replace('\n',' / '))
        json.dump(entries, open('/tmp/reaper_api_entries.json','w'))
        
        ```
        
