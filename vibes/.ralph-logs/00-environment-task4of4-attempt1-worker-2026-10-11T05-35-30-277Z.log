        def clean(s):
            s = re.sub(r'<br\s*/?>', '\n', s)
            s = re.sub(r'<[^>]+>', '', s)
            s = h.unescape(s)
            s = re.sub(r'[ \t]+', ' ', s)
            s = re.sub(r'\n\s*', '\n', s)
            return s.strip()
        
        # Split on anchors
        parts = re.split(r'<a name="([^"]+)"><hr></a>', raw)
        # parts: [pre, name1, body1, name2, body2, ...]
        entries = {}
        for i in range(1, len(parts)-1, 2):
            name, body = parts[i], parts[i+1]
            c = re.search(r'<div class="c_func"[^>]*>(.*?)</div>', body, re.S)
            e = re.search(r'<div class="e_func"[^>]*>(.*?)</div>', body, re.S)
            l = re.search(r'<div class="l_func"[^>]*>(.*?)</div>', body, re.S)
            p = re.search(r'<div class="p_func"[^>]*>(.*?)</div>', body, re.S)
            doc = body
            m = re.search(r'</div>\s*(.*)', body, re.S)
            doc = m.group(1) if m else body
            doc = clean(doc)
            entries[name] = {
                'c': clean(c.group(1)) if c else '',
                'e': clean(e.group(1)) if e else '',
                'l': clean(l.group(1)) if l else '',
                'p': clean(p.group(1)) if p else '',
                'doc': doc,
            }
        
        print("total entries:", len(entries))
        names = sorted(entries.keys())
        # print compactly
        import textwrap
        line = []
        for n in names:
            line.append(n)
            if len(line) == 4:
                print(' | '.join(line)); line = []
        if line: print(' | '.join(line))
        json.dump(entries, open('/tmp/reaper_api_entries.json','w'))
