```nix
{
  description = "REAPER extension for Blackmagic Speed Editor transport control";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    utils.url = "github:numtide/flake-utils";
  };

  outputs = { self, nixpkgs, utils }:
    (utils.lib.eachSystem ["x86_64-linux" ] (system:
      let
        pkgs = import nixpkgs {
          inherit system;
          config.allowUnfree = true; # REAPER binary for manual testing
        };
  in rec {
    devShell = pkgs.mkShell {
      buildInputs = with pkgs; [
        # build toolchain
        cmake
        ninja
        gcc
        pkg-config
        git
        gdb
        valgrind

        # SWELL on Linux needs gdk-3.0 headers at build time (pkg-config)
        gtk3

        # Speed Editor is USB HID
        libhidapi
        libusb1
        udev

        # REAPER binary for manual testing
        reaper
      ];
      CXXFLAGS = "-std=c++17";
      shellHook = ''
        echo "Welcome to the speed-reaper development environment!"
        echo "  g++       $(g++ --version | head -1)"
        echo "  cmake     $(cmake --version | head -1)"
        echo "  reaper    $(reaper --version 2>/dev/null || echo n/a)"
        echo "SDK headers: vendor/reaper-sdk/sdk, vendor/WDL"
      '';
    };
  }));
}
```

